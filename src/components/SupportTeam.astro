<svg viewBox="0 0 420 462" role="img" aria-labelledby="team-title team-desc">
  <title id="team-title">Your team, coordinated by Leo</title>
  <desc id="team-desc">An example working arrangement. The client agrees priorities with Leo and receives updates. Leo assigns tasks, coordinates virtual assistants and reviews their work. Three virtual assistant roles cover website updates, content tasks and research or administration. Staffing is agreed for each project.</desc>
  <defs>
    <g id="team-person"><circle cy="-16" r="12"/><path d="M-25 22V14C-25-8 25-8 25 14V22Z"/></g>
    <marker id="team-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1 1L7 4L1 7" fill="none" stroke="currentColor" stroke-width="1.5"/></marker>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="2" color="#b4d4c8">
    <path d="M190 94V158M230 158V94" marker-end="url(#team-arrow)"/>
    <path d="M210 262V294M70 318V294H350V318M210 294V318"/>
  </g>
  <use href="#team-person" transform="translate(210 35)" fill="#dceae4"/>
  <text x="210" y="81" text-anchor="middle" fill="var(--paper)" font-size="21" font-weight="700">Client / business owner</text>
  <g fill="#dceae4" font-size="15"><text x="172" y="123" text-anchor="end">Priorities</text><text x="249" y="142">Updates</text></g>
  <rect x="74" y="163" width="272" height="99" rx="12" fill="none" stroke="var(--mint)" stroke-width="2"/>
  <use href="#team-person" transform="translate(114 208) scale(.8)" fill="var(--mint)"/>
  <text x="158" y="196" fill="var(--mint)" font-size="26" font-weight="750">Leo</text>
  <text x="158" y="220" fill="var(--paper)" font-size="17">Directs &amp; coordinates</text>
  <text x="158" y="244" fill="var(--paper)" font-size="17">Assigns &amp; reviews</text>
  {[
    {x:70,role:'Website VA',a:'Page updates',b:'& maintenance'},
    {x:210,role:'Content VA',a:'Content tasks',b:'& publishing'},
    {x:350,role:'Research VA',a:'Research',b:'& admin'},
  ].map(p => <g>
    <use href="#team-person" transform={`translate(${p.x} 349) scale(.85)`} fill="#94bfd5"/>
    <text x={p.x} y="394" text-anchor="middle" fill="var(--paper)" font-size="18" font-weight="700">{p.role}</text>
    <text x={p.x} y="420" text-anchor="middle" fill="#dceae4" font-size="15"><tspan x={p.x}>{p.a}</tspan><tspan x={p.x} dy="21">{p.b}</tspan></text>
  </g>)}
</svg>
<style>svg { display:block; width:100%; height:auto; margin-block:24px 16px; }</style>
