<svg viewBox="0 0 400 438" role="img" aria-labelledby="topic-map-title topic-map-desc">
  <title id="topic-map-title">Connected content builds topical depth</title>
  <desc id="topic-map-desc">Example content map for a plumbing business. The core plumbing services page connects to blocked drains and leak repairs. Supporting pages answer questions about drain causes, prevention, leak warning signs and repair costs. Lines represent relevant internal links, not measured rankings.</desc>
  <g fill="none" stroke="var(--mint)" stroke-width="2" opacity=".65">
    <path d="M200 82V110M100 142V110H300V142M100 206V238H16V382H28M300 206V238H384V382H372M16 294H28M384 294H372"/>
  </g>
  <rect x="92" y="16" width="216" height="66" rx="10" fill="var(--mint)"/>
  <text x="200" y="42" text-anchor="middle" fill="#041411" font-size="15">CORE TOPIC</text>
  <text x="200" y="66" text-anchor="middle" fill="#041411" font-size="22" font-weight="750">Plumbing services</text>
  {[{x:20,c:100,label:'Blocked drains'},{x:220,c:300,label:'Leak repairs'}].map(n => <g>
    <rect x={n.x} y="142" width="160" height="64" rx="8" fill="#173852" stroke="#85b8d2"/>
    <text x={n.c} y="166" text-anchor="middle" fill="#e7f2f7" font-size="14">SERVICE PAGE</text>
    <text x={n.c} y="190" text-anchor="middle" fill="#fff" font-size="19" font-weight="700">{n.label}</text>
  </g>)}
  {[
    {x:28,c:104,y:264,a:'What causes',b:'blocked drains?'},
    {x:220,c:296,y:264,a:'Signs of a',b:'hidden leak'},
    {x:28,c:104,y:352,a:'How to prevent',b:'drain blockages'},
    {x:220,c:296,y:352,a:'What affects',b:'repair costs?'},
  ].map(n => <g>
    <rect x={n.x} y={n.y} width="152" height="60" rx="8" fill="#0b241d" stroke="#77998d"/>
    <text x={n.c} y={n.y+24} text-anchor="middle" fill="#f0f6f2" font-size="18"><tspan x={n.c}>{n.a}</tspan><tspan x={n.c} dy="23">{n.b}</tspan></text>
  </g>)}
</svg>
<style>svg { display:block; width:100%; height:auto; margin-block:24px 8px; }</style>
