---
import Layout from '../../layouts/Layout.astro';
import LocalRankMap from '../../components/LocalRankMap.astro';
import TopicMap from '../../components/TopicMap.astro';
import WebsiteWireframe from '../../components/WebsiteWireframe.astro';
import SupportTeam from '../../components/SupportTeam.astro';
import BusinessWorkflow from '../../components/BusinessWorkflow.astro';
import {services} from '../../sanity-content.js';
import {serviceDetails} from '../../service-details.js';
import {serviceFaqs} from '../../service-faqs.js';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service:s}=Astro.props;
const d = serviceDetails[s.slug];
const isAgentic = s.slug === 'agentic-seo';
const isLocal = s.slug === 'local-seo';
const isContent = s.slug === 'website-content';
const isWebsite = s.slug === 'custom-websites';
const isSupport = s.slug === 'growth-support';
const isApp = s.slug === 'basic-app-development';
const isOperations = isApp || s.slug === 'business-automation';
---
<Layout title={s.seoTitle || s.name} description={s.seoDescription || s.summary}>
  <article class="wrap service-detail">
    <a class="text-link" href="/services/">All services</a>
    <header class="detail-lead">
      <div><h1>{s.name}<span>{d.headline}</span></h1><p class="intro">{s.body}</p><div class="actions"><a class="button" href="/contact/">Book a Strategy Call</a><a class="text-link" href={isOperations ? "/contact/" : "/audit/"}>{isOperations ? "Discuss Your Workflow" : "Request an SEO Audit"}</a></div></div>
      <figure class="service-graph">
        {isOperations ? <><figcaption>{d.graph}<small>Illustrative workflow—not a live app or a connected automation.</small></figcaption><BusinessWorkflow app={isApp} /><p>Scope, data access, approvals and ongoing support are agreed before implementation.</p></> : <>
        <figcaption>{isSupport ? 'Specialist support. One person accountable.' : isWebsite ? 'Every element has a purpose' : isContent ? 'Build topical authority through connected content' : isLocal ? 'Your local search visibility' : d.graph}<small>{isSupport ? 'Example team setup—roles and staffing are agreed around your scope.' : isWebsite ? 'An example wireframe: structure first, visual design next.' : isContent ? 'Example topic map for a plumbing business. Lines represent internal links.' : isLocal ? 'Illustrative ranking heat map—not live Google Maps data.' : 'Illustrative direction—not actual results or a forecast.'}</small></figcaption>
        {isSupport ? <SupportTeam /> : isWebsite ? <WebsiteWireframe /> : isContent ? <TopicMap /> : isLocal ? <LocalRankMap /> : <svg viewBox="0 0 480 300" role="img" aria-labelledby="chart-title chart-desc">
          <title id="chart-title">Illustrative improvement in {d.graph.toLowerCase()}</title>
          <desc id="chart-desc">{isAgentic ? 'A conceptual line stays nearly flat before rising sharply. A pointer marks the turning point: This is where Agentic SEO comes in. This is illustrative, not a prediction of speed or results.' : 'A conceptual line rises unevenly from a starting point through improvements and review. There are no measured values or guaranteed outcomes.'}</desc>
          <g stroke="currentColor" opacity=".22"><path d="M36 46H456M36 108H456M36 170H456M36 232H456"/><path d="M36 30V232"/></g>
          <path d={isAgentic ? 'M36 222L96 220L156 222L216 218L258 202L296 152L330 84L360 42L408 26L456 16' : 'M36 222L96 210L156 214L216 164L276 175L336 112L396 88L456 42'} fill="none" stroke="var(--mint)" stroke-width="4" stroke-linejoin="round"/>
          <g fill="var(--mint)"><circle cx="36" cy="222" r="5"/><circle cx="216" cy={isAgentic ? 218 : 164} r="5"/><circle cx="456" cy={isAgentic ? 16 : 42} r="5"/></g>
          {isAgentic && <g class="graph-turning-point">
            <text x="52" y="62" fill="var(--paper)" font-size="22" font-weight="650"><tspan x="52">This is where</tspan><tspan x="52" dy="28">Agentic SEO</tspan><tspan x="52" dy="28">comes in.</tspan></text>
            <path d="M150 134C150 168 185 164 210 201M199 197L212 205L214 190" fill="none" stroke="var(--paper)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="216" cy="218" r="10" fill="none" stroke="var(--paper)" stroke-width="2"/>
          </g>}
          <g fill="currentColor" font-size="15"><text x="36" y="269">Starting point</text><text x="210" y="269">Improve</text><text x="456" y="269" text-anchor="end">Review</text></g>
        </svg>}
        <p>{isSupport ? 'You agree priorities with Leo. Leo coordinates the agreed specialists, assigns tasks, reviews delivery and keeps you updated—so you have one clear point of contact.' : isWebsite ? 'Guide visitors from understanding your offer to taking action. Your final layout is shaped around your content, audience and goals—not a fixed template.' : isContent ? 'Connect your core topic, service pages and useful answers into a coherent body of content. This illustrates a content structure—not an authority score or a ranking guarantee.' : isLocal ? 'Green 1 = example position #1 at a search location. Fictional map and rankings: actual positions vary by search, location and time. Number-one rankings are not guaranteed.' : isAgentic ? 'A turning point, illustrated. The steep rise represents the ambition—not a promised speed, timeline or result.' : 'Progress is rarely a straight line. The work starts with a baseline and improves through review.'}</p>
        </>}
      </figure>
    </header>
    <section class="detail-section"><h2>Is this right for your business?</h2><div><p class="intro">{d.fit}</p><p>{d.outcome} That is the direction we work towards, with priorities based on your starting point and available resources.</p></div></section>
    <section class="detail-section"><h2>What we can work on</h2><div class="detail-deliverables">{s.items.map((item,i)=><div><h3>{item}</h3><p>{d.deliverables[i]}</p></div>)}</div></section>
    <section class="detail-section"><h2>How the work happens</h2><ol class="detail-steps">{d.steps.map(step=><li>{step}</li>)}</ol></section>
    <section class="detail-section"><h2>How we evaluate progress</h2><div><p>{d.measure}</p><p>Access, tracking and reporting are agreed as part of the scope. Specific rankings, leads, revenue, time savings or hiring outcomes are not guaranteed.</p></div></section>
    <section class="detail-section" aria-labelledby="service-faq-heading"><h2 id="service-faq-heading">{s.name} FAQs</h2><div class="faq">{[d.faq, ...serviceFaqs[s.slug]].map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}<details><summary>What will the project cost and how long will it take?<span aria-hidden="true">+</span></summary><p>Share your website, goals and most urgent needs. We agree on deliverables, timing, responsibilities and cost before work begins; additional work requires an agreed scope.</p></details></div></section>
    <section class="detail-contact"><h2>Let’s choose your next useful step.</h2><p>Tell me what you want your business to achieve and where things feel stuck. You work directly with Leo to decide what belongs in the plan.</p><div class="actions"><a class="button" href="/contact/">Book a Strategy Call</a><a class="text-link" href="/services/">Compare all services</a></div></section>
  </article>
</Layout>
<style>
  .service-detail { padding-block: 64px 96px; }
  .detail-lead { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:48px; align-items:center; margin-block:40px 80px; }
  h1 { font-size:clamp(2.5rem,4.8vw,4.5rem); line-height:1.05; letter-spacing:-.035em; margin:0 0 28px; }
  h1 span { display:block; color:var(--mint); margin-top:16px; font-size:.68em; line-height:1.15; }
  h2 { font-size:clamp(1.7rem,2.8vw,2.5rem); line-height:1.15; letter-spacing:-.025em; margin:0; text-wrap:balance; }
  h3 { font-size:1.25rem; line-height:1.3; margin:0 0 12px; }
  p { line-height:1.65; max-width:68ch; margin:0 0 20px; }
  .intro { font-size:1.12rem; }
  .service-graph { margin:0; padding:28px; background:var(--panel); border:1px solid var(--line); border-radius:12px; }
  figcaption { font-size:1.2rem; font-weight:700; }
  figcaption small { display:block; margin-top:12px; font-size:.85rem; font-weight:400; line-height:1.5; }
  svg { display:block; width:100%; height:auto; margin-block:24px 8px; }
  .service-graph p { font-size:.9rem; margin:0; }
  .detail-section { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:64px; border-top:1px solid var(--line); padding-block:48px; }
  .detail-deliverables { display:grid; gap:28px; }
  .detail-deliverables p { margin:0; }
  .detail-steps { margin:0; padding-left:24px; }
  .detail-steps li { padding-left:12px; padding-bottom:24px; line-height:1.65; }
  .detail-steps li::marker { color:var(--mint); font-weight:700; }
  .faq { min-width:0; }
  .faq summary { gap:20px; line-height:1.5; }
  .detail-contact { border-top:1px solid var(--line); padding-top:56px; max-width:760px; }
  .detail-contact h2 { margin-bottom:24px; }
  @media(max-width:900px) { .detail-lead { grid-template-columns:1fr; gap:40px; } .service-graph { max-width:640px; } }
  @media(max-width:600px) { .service-detail { padding-block:40px 64px; } .detail-lead { margin-block:32px 48px; } .detail-section { grid-template-columns:1fr; gap:24px; padding-block:32px; } .service-graph { padding:20px; } .actions { align-items:flex-start; } }
</style>
