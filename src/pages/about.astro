---
import Layout from '../layouts/Layout.astro';
import {aboutPage as ap, siteSettings as ss} from '../sanity-content.js';

const heroLines = ap.heroLines?.length ? ap.heroLines : [
  'Reach the **right customers.**',
  'Give them a reason to **choose you.**',
  'Build with **Leo.**',
];
const intro = ap.intro || "I'm Leo, founder of RankwithLeo. I connect Agentic SEO, useful content and clear websites to help the right customers find and choose you. I also build business automations and simple web apps to reduce repetitive work and make everyday tasks easier to manage. You work directly with me—from deciding what matters to putting the plan into practice.";
const outcomesHeading = ap.outcomesHeading || 'What working together should give you.';
const outcomesSubtext = ap.outcomesSubtext || 'Not another pile of ideas. A useful direction, work that moves and a person who stays accountable.';
const outcomes = ap.outcomes?.length ? ap.outcomes : [
  {title:'**Clear** priorities', description:'See what matters now, why it matters and what can wait—before time is spent on the wrong task.'},
  {title:'Work that gets **implemented**', description:'Turn agreed priorities into useful pages, content, connected workflows or a small app your team can put to work.'},
  {title:'One partner **accountable**', description:'Work directly with me through the priorities, decisions and delivery, with a clear view of what happens next.'},
];
const workingHeading = ap.workingHeading || 'Built around **your business.**';
const workingParagraphs = ap.workingParagraphs?.length ? ap.workingParagraphs : [
  'I use Codex to help with research, analysis and implementation. It supports the work; it does not replace my judgment or responsibility for quality.',
  'For operational work, we start with the task—not a tool. That could mean connecting an enquiry form to a task tracker, streamlining a recurring report or building a simple internal app. We agree on access, human checks and maintenance before anything goes live.',
  'I work with businesses worldwide, with particular experience across trades, recruitment and outsourcing. We begin with your audience, your current website and the business outcome you need it to support.',
];
const closeHeading = ap.closeHeading || "Bring the business problem. We'll find the right starting point.";
const closeSubtext = ap.closeSubtext || 'You do not need a perfect brief. Tell me what feels stuck and what a better outcome would look like.';

const seoTitle = ap.seoTitle || 'About Leo';
const seoDescription = ap.seoDescription || 'Work directly with Leo on Agentic SEO, websites, business automation and basic app development for your small business.';
const ctaPrimary = ss.primaryCta?.label || 'Book a Strategy Call';
const ctaPrimaryUrl = ss.primaryCta?.url || '/contact/';

function bold(text) { return text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>'); }
---

<Layout title={seoTitle} description={seoDescription}>
  <article class="about-page">
    <section class="wrap about-hero" aria-labelledby="about-title">
      <div class="about-hero-copy">
        <h1 id="about-title">
          {heroLines.map((line, i) => <span class="about-line" style={`--word-delay: ${i * 70}ms`} set:html={bold(line)} />)}
        </h1>
        <p class="about-intro">{intro}</p>
        <div class="actions">
          <a class="button" href={ctaPrimaryUrl}>{ctaPrimary}</a>
          <a class="button secondary" href="/work/">See Selected Work</a>
        </div>
      </div>

      <figure class="about-portrait">
        <img src="/assets/plates/about-leo-ai-studio.png" alt="Leo in an illustrative studio with AI workflow symbols, code and search tools behind him" width="1122" height="1402" loading="eager" fetchpriority="high" />
        <figcaption>Human-led strategy. AI-supported delivery. Illustrative studio portrait.</figcaption>
      </figure>
    </section>

    <section class="wrap about-outcomes" aria-labelledby="outcomes-title">
      <header>
        <h2 id="outcomes-title">{outcomesHeading}</h2>
        <p>{outcomesSubtext}</p>
      </header>

      <div class="about-outcome-list">
        {outcomes.map(o => <div><h3 set:html={bold(o.title)} /><p>{o.description}</p></div>)}
      </div>
    </section>

    <section class="wrap about-working" aria-labelledby="working-title">
      <h2 id="working-title" set:html={bold(workingHeading)} />
      <div>
        {workingParagraphs.map(p => <p>{p}</p>)}
        <a class="text-link" href="/services/">Explore how I can help</a>
      </div>
    </section>

    <section class="wrap about-close" aria-labelledby="about-close-title">
      <div>
        <h2 id="about-close-title">{closeHeading}</h2>
        <p>{closeSubtext}</p>
      </div>
      <a class="button" href={ctaPrimaryUrl}>Talk About Your Business</a>
    </section>
  </article>
</Layout>
