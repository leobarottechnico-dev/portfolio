---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import {services, posts, homePage as hp, siteSettings as ss} from '../sanity-content.js';

const heroTitle = (hp.heroTitle || 'Agentic SEO,|directed by Leo.').split('|');
const heroSubtitle = hp.heroSubtitle || 'I help your business get found through Agentic SEO—and streamline everyday work with business automation and simple web apps.';
const chapters = hp.chapters?.length ? hp.chapters : [
  'Human judgment.|AI-agent power.',
  'A sharper lens|on search.',
  'Find the businesses behind the data.',
  'Aim strategy at the right opportunity.',
  'Keep your business|goal in sight.',
];
const workHeading = (hp.workHeading || 'The work behind|the thinking.').split('|');
const workSubtext = hp.workSubtext || 'Selected work with Antons Plumbing & Gas and Antons Renovations.';
const servicesHeading = (hp.servicesHeading || 'Search is the start.|The business is the point.').split('|');
const servicesSubtext = hp.servicesSubtext || 'Agentic SEO helps customers find you. Content and websites help them choose you. Business automation, simple apps and practical support help your team handle what comes next.';
const processHeading = (hp.processHeading || 'A clear process.|A person accountable.').split('|');
const processSubtext = hp.processSubtext || 'I direct the work. Codex helps with research, analysis and implementation. You know who is making the decisions.';
const processSteps = hp.processSteps?.length ? hp.processSteps : [
  {title:'Diagnose',description:'Understand your customers, website and the manual tasks slowing your team down.'},
  {title:'Prioritize',description:'Agree what matters first and what a useful outcome looks like.'},
  {title:'Build',description:'Turn the agreed plan into pages, content, automations or a focused web app.'},
  {title:'Measure & improve',description:'Test the work, review the evidence and decide what comes next.'},
];
const aboutHeading = (hp.aboutHeading || 'Your SEO partner.|Hi, I\'m Leo.').split('|');
const aboutIntro = hp.aboutIntro || 'I bring together Agentic SEO, content and websites with business automation and basic app development—helping customers find you and helping your team work more efficiently.';
const aboutBody = hp.aboutBody || 'You work directly with me, from the first conversation through the decisions and the delivery. I work with small businesses worldwide, including trades, recruiters and outsourcing agencies.';
const blogHeading = (hp.blogHeading || 'Notes from|the work.').split('|');
const blogSubtext = hp.blogSubtext || 'Ideas and practical answers from the search, content and website work I do with businesses.';
const faqs = hp.faqs?.length ? hp.faqs.map(f => [f.question, f.answer]) : [
  ['Can you streamline repetitive business tasks?', 'Yes. I offer business automation for suitable tasks such as enquiry handoffs, internal reminders, data updates and routine reporting. We map the process, confirm tool compatibility and agree on approvals and error handling before enabling it.'],
  ['Can you build a simple app for my business?', 'Yes. Basic app development covers focused web tools such as internal trackers, request forms, calculators and simple dashboards. We agree on the features, data needs, hosting and support before building; complex enterprise or native mobile apps are outside this standard scope.'],
  ['What is Agentic SEO—and how does it help my business?', 'Agentic SEO uses AI agents to support research, analysis and implementation, with a person directing the work. I use Codex to help turn search opportunities into useful content and website improvements, with the goal of attracting relevant visitors and making it easier for them to enquire.'],
  ['Do you work with businesses in the UK, Australia and the US?', 'Yes. I work remotely with businesses in these markets and worldwide. We plan around your audience, service area and local language, so your website speaks to the customers you want to reach.'],
  ['How will we work across time zones?', 'Before starting, we agree on meeting windows, response expectations and a shared place for updates. Written progress notes and clear next steps help keep work moving without requiring you to attend every discussion.'],
  ['Can you help me hire virtual staff?', 'Yes. We can scope support for defining roles, sourcing and screening candidates, and coordinating onboarding. Tell me which tasks you need covered and your budget; we will agree on my responsibilities before recruitment begins. Candidate availability and hiring timelines depend on the role.'],
  ['Can you support another virtual agency or outsourcing team?', 'Yes. We can discuss white-label or overflow support for SEO, content, website tasks and virtual assistance. We agree on deliverables, confidentiality, client communication and who reviews the work, so the support fits your existing team.'],
  ['Will I work with Leo directly or with a team?', 'You work directly with me on priorities, decisions and delivery. If your scope needs additional specialists or virtual staff, we agree on their involvement and responsibilities first.'],
  ['Can you improve my existing WordPress website?', 'Yes. I can work on custom pages, content and SEO improvements without assuming you need a full rebuild. The aim is a clearer, more useful website that helps visitors understand your offer and take the next step.'],
  ['Can we start small and add support as the business grows?', 'Yes. We can begin with a focused audit or a defined set of tasks, then review the priorities before expanding. Scope, timing and cost are agreed before additional work starts.'],
  ['Do you guarantee rankings, leads or hires?', 'No. Search performance, customer decisions and hiring outcomes depend on factors beyond our control. We agree on the work, useful measures of progress and regular reviews, with no promises of specific rankings, revenue or placements.'],
];
const closingHandwriting = hp.closingHandwriting || 'A clearer next move starts here.';
const closingHeading = (hp.closingHeading || "Let's find your|search opportunity.").split('|');

const ctaPrimary = ss.primaryCta?.label || 'Book a Strategy Call';
const ctaPrimaryUrl = ss.primaryCta?.url || '/contact/';
const ctaSecondary = ss.secondaryCta?.label || 'Request an SEO Audit';
const ctaSecondaryUrl = ss.secondaryCta?.url || '/audit/';
---
<Layout>
  <section class="cinematic-hero" data-cinematic-hero aria-labelledby="hero-title" aria-describedby="cinematic-summary">
    <div class="cinematic-sticky">
      <div class="cinematic-media" aria-hidden="true">
        <img class="cinematic-poster" src="/assets/plates/hero-portrait-polished.png" alt="" width="1672" height="941" fetchpriority="high" />
        <img class="cinematic-poster cinematic-enhancement" data-cyborg src="/assets/plates/hero-cyborg.png" alt="" width="1672" height="941" decoding="async" />
        <video
          class="cinematic-film"
          src="/assets/cinematic/rankwithleo-sequence.mp4"
          poster="/assets/plates/hero-portrait-polished.png"
          preload="metadata"
          muted
          playsinline
          tabindex="-1"
        ></video>
        <img class="cinematic-poster cinematic-bullseye" data-bullseye src="/assets/plates/hero-bullseye.png" alt="" width="1672" height="941" decoding="async" />
      </div>

      <div class="cinematic-shade" aria-hidden="true"></div>
      <a class="cinematic-skip" href="#work">Skip cinematic</a>

      <div class="cinematic-intro">
        <div class="cinematic-intro-copy">
          <h1 id="hero-title" set:html={heroTitle.map((line, i) => i === heroTitle.length - 1 ? line.replace(/(\w+)\.$/, '<span>$1.</span>') : line).join('<br />')} />
          <p>{heroSubtitle}</p>
        </div>
        <div class="actions">
          <a class="button" href={ctaPrimaryUrl}><span>{ctaPrimary}</span></a>
          <a class="button secondary" href={ctaSecondaryUrl}><span>{ctaSecondary}</span></a>
        </div>
      </div>

      <div class="cinematic-chapters" aria-hidden="true">
        {chapters.map(ch => <p data-cinematic-chapter set:html={ch.split('|').join('<br />')} />)}
      </div>

      <div class="cinematic-status">
        <span class="cinematic-progress" aria-hidden="true"><i></i></span>
        <p>Illustrative growth story. Not client performance data.</p>
      </div>
    </div>

    <p class="visually-hidden" id="cinematic-summary">
      Leo's portrait transforms into a blue-eyed cyborg, symbolizing human judgment empowered by AI agents. The original magnifying-glass zoom footage continues into illustrative business growth and Leo as an archer. The ending reveals an arrow embedded in the red centre of a bullseye before transitioning to selected clients. This symbolic sequence contains no actual client metrics or guaranteed outcomes.
    </p>
  </section>

  <section class="wrap section selected-work" id="work" tabindex="-1">
    <div class="section-heading">
      <div><h2 set:html={workHeading.join('<br />')} /><p>{workSubtext}</p></div>
      <a class="text-link" href="/work/">Explore all work</a>
    </div>
    <Projects />
  </section>

  <section class="service-section section" id="services">
    <div class="wrap">
      <div class="section-heading"><h2 set:html={servicesHeading.map((part,i) => i > 0 ? `<em>${part}</em>` : part).join('<br />')} /><p>{servicesSubtext}</p></div>
      <div class="service-list">{services.map((s,i)=><a href={`/services/${s.slug}/`}><span class="service-number">{String(i+1).padStart(2,'0')}</span><h3>{s.name}</h3><p>{s.summary}</p><span class="service-action">View</span></a>)}</div>
    </div>
  </section>

  <section class="wrap section" id="approach">
    <div class="section-heading"><h2 set:html={processHeading.join('<br />')} /><p>{processSubtext}</p></div>
    <ol class="process">{processSteps.map(({title,description})=><li><h3>{title}</h3><p>{description}</p></li>)}</ol>
  </section>

  <section class="wrap about-block section"><h2 set:html={aboutHeading.map((part,i) => i > 0 ? `<em>${part}</em>` : part).join('<br />')} /><div><p class="intro">{aboutIntro}</p><p>{aboutBody}</p><a class="text-link" href="/about/">More about working with me</a></div></section>
  {posts.length > 0 && <section class="wrap section latest-posts" aria-labelledby="latest-posts-title">
    <div class="section-heading"><h2 id="latest-posts-title">{blogHeading[0]}{blogHeading[1] && <><br /><em>{blogHeading[1]}</em></>}</h2><p>{blogSubtext}</p></div>
    <div class="latest-post-list">{posts.slice(0, 3).map(post => <a href={`/blog/${post.slug.current}/`}><span>{post.category || 'Article'}</span><h3>{post.title}</h3><p>{post.excerpt}</p><span class="latest-post-action">Read article ↗</span></a>)}</div>
    <a class="text-link" href="/blog/">View all articles</a>
  </section>}
  <section class="wrap section faq" aria-labelledby="faq-title">
    <h2 id="faq-title">A few useful answers.</h2>
    {faqs.map(([q, a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}
  </section>
  <section class="closing"><div class="wrap"><p class="handwriting">{closingHandwriting}</p><h2 set:html={closingHeading.join('<br />')} /><div class="actions"><a class="button" href={ctaPrimaryUrl}>{ctaPrimary}</a><a class="text-link" href={ctaSecondaryUrl}>Start with an SEO audit</a></div></div></section>
  <script src="../scripts/cinematic-hero.ts"></script>
</Layout>
<style>
  .latest-posts { border-top: 1px solid var(--line); }
  .latest-post-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3vw, 50px); margin-block: 50px 32px; }
  .latest-post-list a { display: block; border-top: 1px solid var(--line); padding-top: 24px; }
  .latest-post-list a > span:first-child { color: var(--mint); font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .latest-post-list h3 { margin: 16px 0; font-size: clamp(1.4rem, 2vw, 2rem); line-height: 1.14; letter-spacing: -.025em; }
  .latest-post-list p { color: var(--muted); line-height: 1.6; }
  .latest-post-action { display: inline-block; margin-top: 12px; color: var(--mint); font-size: .9rem; font-weight: 700; }
  @media (max-width: 760px) { .latest-post-list { grid-template-columns: 1fr; gap: 38px; } }
</style>
