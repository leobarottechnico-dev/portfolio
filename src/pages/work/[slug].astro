---
import Layout from '../../layouts/Layout.astro';import {projects} from '../../data.js';export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}const {project:p}=Astro.props;
---
<Layout title={p.name} noindex={true}><article class="wrap section page-top reading"><a class="text-link" href="/work/">← Selected work</a><h1>{p.name}</h1><p class="intro">{p.industry}</p><div class={`project-art ${p.color}`}><span class="monogram" aria-hidden="true">{p.symbol}</span><span class="project-industry">Project overview</span></div><h2>Case study in preparation.</h2><p>This project is part of Leo’s selected client work. The detailed brief, Leo’s responsibilities, deliverables and verified results are being prepared for publication.</p><p>Project screenshots and client-approved evidence will be added here. No performance results are claimed in this preview.</p>{p.domain&&<a class="text-link" href={`https://${p.domain}`} target="_blank" rel="noopener noreferrer">Visit the client website ↗</a>}<h2>Have a similar project?</h2><p>Tell me about your business and what you would like to improve.</p><a class="button" href="/contact/">Discuss your project ↗</a></article></Layout>
