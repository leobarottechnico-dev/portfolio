---
import Layout from '../../layouts/Layout.astro';
import { PortableText } from 'astro-portabletext';
import BlogBodyImage from '../../components/BlogBodyImage.astro';
import { posts } from '../../sanity-content.js';
import { imageUrl } from '../../sanity-image.js';

export function getStaticPaths() {
  return posts.map(post => ({ params: { slug: post.slug.current }, props: { post } }));
}

const { post } = Astro.props;
const dateLabel = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(post.publishedAt));
const coverUrl = imageUrl(post.coverImage, 1600);
const components = { type: { image: BlogBodyImage } };
---
<Layout title={post.seoTitle || post.title} description={post.seoDescription || post.excerpt} ogType="article" ogImage={coverUrl || undefined}>
  <article class="blog-article">
    <div class="wrap article-heading">
      <a class="back-link" href="/blog/">← All articles</a>
      <div class="article-meta"><time datetime={post.publishedAt}>{dateLabel}</time>{post.category && <span>{post.category}</span>}</div>
      <h1>{post.title}</h1>
      <p class="article-excerpt">{post.excerpt}</p>
    </div>
    {coverUrl && <figure class="wrap article-cover"><img src={coverUrl} alt={post.coverImage.alt || ''} width="1600" loading="eager" decoding="async" /></figure>}
    <div class="wrap article-grid">
      <aside class="article-aside"><span>Written by Leo</span><a href="/about/">About the author ↗</a></aside>
      <div class="article-body"><PortableText value={post.body} components={components} /></div>
    </div>
    <div class="wrap article-end"><a class="text-link" href="/blog/">← Back to all articles</a><a class="text-link" href="/contact/">Discuss a project ↗</a></div>
  </article>
</Layout>
<style>
  .blog-article { padding-block: 46px 110px; }
  .article-heading { max-width: 1100px; }
  .back-link { display: inline-block; margin-bottom: 72px; color: var(--mint); font-size: .9rem; font-weight: 700; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; color: var(--muted); font-size: .78rem; font-weight: 680; letter-spacing: .08em; text-transform: uppercase; }
  .article-meta span { color: var(--mint); }
  h1 { max-width: 17ch; margin: 22px 0 25px; font-size: clamp(3rem, 6vw, 5.7rem); line-height: .99; letter-spacing: -.04em; text-wrap: balance; }
  .article-excerpt { max-width: 65ch; color: var(--muted); font-size: clamp(1.1rem, 1.55vw, 1.35rem); line-height: 1.55; }
  .article-cover { margin-block: 68px; }
  .article-cover img { display: block; width: 100%; height: auto; max-height: 690px; object-fit: cover; border-radius: var(--radius); }
  .article-grid { display: grid; grid-template-columns: minmax(170px, .36fr) minmax(0, 1fr); gap: 7vw; padding-top: 45px; border-top: 1px solid var(--line); }
  .article-aside { display: grid; align-content: start; gap: 9px; color: var(--muted); font-size: .86rem; }
  .article-aside a { width: max-content; color: var(--mint); }
  .article-body { max-width: 75ch; min-width: 0; font-size: 1.08rem; line-height: 1.8; overflow-wrap: break-word; }
  .article-body :global(p) { margin: 0 0 1.5em; }
  .article-body :global(h2) { margin: 2.3em 0 .7em; font-size: clamp(1.7rem, 2.8vw, 2.6rem); line-height: 1.15; letter-spacing: -.025em; }
  .article-body :global(h3) { margin: 2em 0 .65em; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.2; }
  .article-body :global(a) { color: var(--mint); text-decoration: underline; text-underline-offset: .2em; }
  .article-body :global(blockquote) { margin: 2em 0; padding: .2em 0 .2em 1.5em; border-left: 1px solid var(--mint); color: var(--paper); font-size: 1.2em; line-height: 1.5; }
  .article-body :global(ul), .article-body :global(ol) { padding-left: 1.4em; margin: 0 0 1.5em; }
  .article-body :global(li) { padding-left: .3em; margin-bottom: .45em; }
  .article-body :global(li::marker) { color: var(--mint); }
  .article-body :global(code) { padding: .1em .3em; border-radius: 4px; background: var(--panel); font-size: .9em; }
  .article-end { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 90px; padding-top: 32px; border-top: 1px solid var(--line); }
  @media (max-width: 760px) { .blog-article { padding-block: 36px 75px; } .back-link { margin-bottom: 54px; } .article-cover { margin-block: 42px; } .article-grid { grid-template-columns: 1fr; gap: 32px; } .article-aside { display: flex; gap: 20px; } .article-body { font-size: 1rem; } }
</style>
